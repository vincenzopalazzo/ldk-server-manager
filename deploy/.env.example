# Copy to .env to change the defaults in compose.yaml.

# Lightning node alias.
ALIAS=ldk-node

# Lightning peer port on this machine.
LIGHTNING_PORT=9735

# Dashboard. It binds to this machine only; to open it to your network set WEB_BIND=0.0.0.0
# AND basic auth below, since the dashboard hands out control of the node.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Basic auth for the dashboard. AUTH_HASH is a bcrypt hash, e.g.
#   docker run --rm httpd:alpine htpasswd -nbB admin 'your password' | cut -d: -f2
# In .env, write each $ in the hash as $$.
AUTH_USER=
AUTH_HASH=

# Reach the dashboard through a public domain? List it for the assistant, e.g.
# PUBLIC_ORIGIN=https://node.example.com
PUBLIC_ORIGIN=

# Image versions (ghcr.io/vincenzopalazzo/...). Pin them; upgrade deliberately.
# LDK_SERVER_VERSION=0.1.1
# GOOSE_GATEWAY_VERSION=0.2.2
# WEB_VERSION=0.1.0-rc.1

# Use an existing goose config instead of ./data/goose (e.g. to reuse sign-ins).
# GOOSE_CONFIG_DIR=/home/you/.config/goose
